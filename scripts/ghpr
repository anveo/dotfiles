#!/usr/bin/env bash
set -e

if ! command -v gh &>/dev/null; then
  echo "Error: gh CLI not installed. Install with: brew install gh" >&2
  exit 1
fi

DRY_RUN=false
if [ "${1:-}" = "-n" ] || [ "${1:-}" = "--dry-run" ]; then
  DRY_RUN=true
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD)

# --- Title ---
# Extract Linear issue key from the full branch name (e.g. mon-145 or MON-145)
KEY=$(echo "$BRANCH" | grep -oiE '[a-z]+-[0-9]+' | head -1 | tr '[:lower:]' '[:upper:]')

# Strip user/project prefix (e.g. anveo/mon-145-feature → mon-145-feature)
SLUG="${BRANCH##*/}"

# Convert hyphens to spaces to get the description
DESC=$(echo "$SLUG" | tr '-' ' ')

if [ -n "$KEY" ]; then
  KEY_LETTERS=$(echo "$KEY" | grep -oE '[A-Z]+' | tr '[:upper:]' '[:lower:]')
  KEY_NUMBERS=$(echo "$KEY" | grep -oE '[0-9]+')
  # Remove the key tokens from anywhere in the description
  DESC=$(echo "$DESC" | sed "s/${KEY_LETTERS} ${KEY_NUMBERS}[[:space:]]*//" | sed 's/^[[:space:]]*//')
fi

# Title-case each word in the description
DESC=$(echo "$DESC" | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) tolower(substr($i,2)); print}')

TITLE="${KEY:+${KEY} }${DESC}"

# --- Base branch ---
# 1. An explicit start point, if there was one. `git checkout -b foo main` records
#    "Created from main"; a bare `git checkout -b foo` records the literal string
#    "Created from HEAD", which tells us nothing and falls through to step 2.
BASE=$(git reflog show "$BRANCH" 2>/dev/null \
  | grep "branch: Created from" \
  | head -1 \
  | sed 's/.*Created from //' \
  | sed 's|^origin/||')

# Reject "HEAD", self-references, and names that no longer exist on the remote.
# Deliberately not requiring the base to still be an ancestor of HEAD — a parent
# feature branch may have moved on since we forked, and it is still the right base.
if [ "$BASE" = "HEAD" ] || [ "$BASE" = "$BRANCH" ] || [ -z "$BASE" ] \
  || ! git rev-parse --verify --quiet "refs/remotes/origin/$BASE" >/dev/null; then
  BASE=""
fi

if [ -z "$BASE" ]; then
  # 2. The repo's default branch is the base for an ordinary feature branch.
  DEFAULT=$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name 2>/dev/null || true)

  # 3. Detect a stacked branch: score every remote ref by how many commits HEAD
  #    has that it doesn't — i.e. the distance back to their merge base — closest
  #    first. A sibling forked from the same commit scores identically to the
  #    default branch, which is why step 4 demands a *strict* win before
  #    overriding the default. Sorting alone would hand ties to whichever name
  #    happens to sort first.
  CANDIDATES=$(git for-each-ref --format='%(refname:short)' refs/remotes/origin/ \
    | grep -vE "^origin/HEAD$|^origin/${BRANCH}$" \
    | while read -r ref; do
        printf '%s %s\n' "$(git rev-list --count HEAD "^${ref}" 2>/dev/null || echo 99999)" "${ref#origin/}"
      done \
    | sort -n)

  CLOSEST_N=$(printf '%s\n' "$CANDIDATES" | awk 'NR==1{print $1}')
  CLOSEST=$(printf '%s\n' "$CANDIDATES" | awk 'NR==1{print $2}')

  if [ -n "$DEFAULT" ] && git rev-parse --verify --quiet "refs/remotes/origin/$DEFAULT" >/dev/null; then
    DEFAULT_N=$(git rev-list --count HEAD "^origin/$DEFAULT")
    # 4. Only prefer a stacked branch when it is strictly closer than the default.
    if [ -n "$CLOSEST_N" ] && [ "$CLOSEST_N" -lt "$DEFAULT_N" ]; then
      BASE="$CLOSEST"
    else
      BASE="$DEFAULT"
    fi
  else
    BASE="${DEFAULT:-$CLOSEST}"
  fi
fi

printf 'Branch: %s\nBase:   %s\nTitle:  %s\n\n' "$BRANCH" "$BASE" "$TITLE"

if [ "$DRY_RUN" = true ]; then
  exit 0
fi

if [ -n "$BASE" ]; then
  gh pr create --web --base "$BASE" --title "$TITLE"
else
  gh pr create --web --title "$TITLE"
fi
